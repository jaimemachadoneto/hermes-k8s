 # A custom KeepAlive supervisor keeps its own respawn interval (launchd's is ~once per 10s,
 # per LAUNCHD_SUPERVISION_VERIFY_TIMEOUT); 15s matches _wait_for_launchd_service_pid's budget.
 SUPERVISED_REPLACEMENT_VERIFY_TIMEOUT = 15.0
+# A gateway in another PID namespace is usually a container: its supervisor (the kubelet, Docker's
+# restart policy) restarts the whole container after a back-off, and the gateway then boots before
+# its socket answers. The kubelet back-off doubles up to 5 minutes after repeated restarts, so the
+# budget is that cap plus a minute for the boot.
+FOREIGN_REPLACEMENT_VERIFY_TIMEOUT = 360.0
+FOREIGN_REPLACEMENT_POLL_INTERVAL = 1.0
+# The gateway waits up to 5s for the request to run on its event loop before it answers.
+FOREIGN_PAUSE_TIMEOUT = 8.0
 
 
