+def restart_foreign_supervised_gateway(force: bool = False, home: Path | None = None) -> bool:
+    """Restart a supervised gateway whose PID this process cannot see, through its control socket.
+
+    A gateway in another PID namespace (a second container of the same pod, with the Hermes home on
+    a shared volume) answers on the control socket, but ``get_running_pid`` cannot verify its PID,
+    so the manual fallback started a second gateway in this process (it cannot signal the real
+    one). When the gateway that answers reports a launch supervisor other than ``manual`` (for
+    example ``external`` from ``--external-supervisor``), ``pause-for-update`` makes it exit back to
+    that supervisor: the same hand-back as the SIGUSR1 path above. Success is a replacement that
+    answers ``identify`` with a new PID, start time or instance id, never the bare exit.
+
+    Without ``force`` the gateway restarts when idle: if the same gateway still answers when the
+    wait ends, the restart is left pending (as ``leave_restart_pending`` reports for a visible PID).
+
+    Returns False when no gateway answers, or when the gateway that answers has no known supervisor
+    to start it again: the caller keeps its own path. Exits 1 when the pause is refused, when a
+    forced pause leaves the same gateway, or when no gateway answers in time; it never starts a
+    gateway here.
+    """
+    from gateway.control_socket import identify_gateway, launch_supervisor, pause_gateway_for_update
+    from gateway.status import _get_process_hermes_home
+    from hermes_cli.data_cleanup_holders import pause_acked
+    from hermes_cli.gateway import _print_lines
+    from hermes_cli.update_cmd_drain_report import report_restart_left_pending
+
+    home = home or _get_process_hermes_home()
+    identity = identify_gateway(home)
+    if not identity or launch_supervisor(identity) in (None, "manual"):
+        return False
+
+    def _identity_key(answer: dict) -> tuple:
+        return (answer.get("pid"), answer.get("start_time"), answer.get("instance_id"))
+
+    old_key = _identity_key(identity)
+    old_pid = identity.get("pid")
+    label = f"Gateway PID {old_pid} (another PID namespace)"
+    print(f"→ Restarting supervised gateway (PID {old_pid} in another PID namespace) "
+          "through its control socket...")
+    ack = pause_gateway_for_update(home, timeout=FOREIGN_PAUSE_TIMEOUT, force=force)
+    if not pause_acked(ack, identity):
+        _print_lines(
+            "",
+            "✗ The gateway did not accept pause-for-update on its control socket.",
+            "  Not starting a gateway here: its supervisor owns it.",
+        )
+        sys.exit(1)
+
+    last_answer: dict | None = None
+
+    def _replacement() -> dict | None:
+        nonlocal last_answer
+        last_answer = identify_gateway(home)
+        if last_answer and _identity_key(last_answer) != old_key:
+            return last_answer
+        return None
+
+    budget = float(ack.get("drain_timeout") or 0.0) + FOREIGN_REPLACEMENT_VERIFY_TIMEOUT
+    replacement = poll_until(_replacement, budget, FOREIGN_REPLACEMENT_POLL_INTERVAL)
+    if replacement:
+        print()
+        print(f"✓ Gateway relaunched by its supervisor (PID {replacement.get('pid')})")
+        return True
+    old_gateway_answers = bool(last_answer) and _identity_key(last_answer) == old_key
+    if old_gateway_answers and not force:
+        report_restart_left_pending(label, home, supervised=True)
+        return True
+    _print_lines(
+        "",
+        f"✗ The new gateway did not answer on the control socket within {budget:.0f}s.",
+        "  Not starting a gateway here: check the supervisor of the gateway",
+        "  (for a container, its restart policy and its logs).",
+    )
+    sys.exit(1)
+
 
