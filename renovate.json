{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>jaimemachado/renovate-config", "helpers:pinGitHubActionDigestsToSemver"],
  "nix": { "enabled": true },
  "lockFileMaintenance": { "enabled": true, "schedule": ["before 6am on monday"] },
  "packageRules": [
    {
      "description": "ADR 0009: Hermes stays on a v0.x.y tag. A calendar tag (v2026.x.y) is older than the v0.2x.y tags.",
      "matchPackageNames": ["NousResearch/hermes-agent"],
      "allowedVersions": "/^v0\\.\\d+\\.\\d+$/"
    }
  ]
}
